#ifndef __VMLINUX_H__
#define __VMLINUX_H__

#ifndef __bpf_core_pai
#if !defined(BPF_NO_PRESERVE_ACCESS_INDEX) && __has_attribute(preserve_access_index)
#define __bpf_core_pai preserve_access_index
#else
#define __bpf_core_pai
#endif
#endif

#ifndef __bpf_core_pso
#if __has_attribute(preserve_static_offset)
#define __bpf_core_pso preserve_static_offset
#else
#define __bpf_core_pso
#endif
#endif

#ifndef __ksym
#define __ksym __attribute__((section(".ksyms")))
#endif

#ifndef __weak
#define __weak __attribute__((weak))
#endif

#ifndef __bpf_fastcall
#if __has_attribute(bpf_fastcall)
#define __bpf_fastcall __attribute__((bpf_fastcall))
#else
#define __bpf_fastcall
#endif
#endif

enum {
	E0 = 1,
};

struct __sk_buff {
	int len;
	union {
		int sk;
	};
} __attribute__((__bpf_core_pso));

struct bpf_nf_ctx {
	int f;
} __attribute__((__bpf_core_pai));

struct bpf_sk_lookup {
	union {
		union {
			int cookie;
		};
		int family;
	};
} __attribute__((__bpf_core_pso));

struct bpf_tcp_sock {
	int snd_cwnd;
} __attribute__((__bpf_core_pso));

struct holey {
	int c;
	long: 32;
	long: 32;
	int tail;
} __attribute__((__bpf_core_pai));

struct s {
	int f;
} __attribute__((__bpf_core_pai));


/* BPF kfuncs */
#ifndef BPF_NO_KFUNC_PROTOTYPES
#endif

#endif /* __VMLINUX_H__ */
