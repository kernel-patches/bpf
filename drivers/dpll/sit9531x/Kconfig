config SIT9531X_DPLL
	tristate "SiTime SiT9531x DPLL driver"
	depends on I2C && NET
	select REGMAP_I2C
	help
	  Driver for SiTime SiT9531x family clock generators
	  (SiT95317, SiT95316).

	  To compile this driver as a module, choose M here: the
	  module will be called sit9531x.
