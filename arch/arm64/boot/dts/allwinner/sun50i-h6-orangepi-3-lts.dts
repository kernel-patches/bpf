#include "sun50i-h6-orangepi.dtsi"

/ {
	model = "OrangePi 3 LTS";
	compatible = "xunlong,orangepi-3-lts", "allwinner,sun50i-h6";

	aliases {
		ethernet0 = &emac;
		ethernet1 = &aw859a;
	};

	leds {
		led-0 {
			pinctrl-names = "default";
			pinctrl-0 = <&led_red_pin>;
		};

		led-1 {
			pinctrl-names = "default";
			pinctrl-0 = <&led_green_pin>;
		};
	};

	reg_gmac_3v3: gmac-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "gmac-3v3";
		vin-supply = <&reg_vcc5v>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <150000>;
		enable-active-high;
		gpio = <&pio 3 6 GPIO_ACTIVE_HIGH>; /* PD6 */
	};

	reg_wifi_3v3: wifi-3v3 {
		/* 3.3V regulator for WiFi and BT */
		compatible = "regulator-fixed";
		regulator-name = "wifi-3v3";
		vin-supply = <&reg_vcc5v>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 7 7 GPIO_ACTIVE_HIGH>; /* PH7 */
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "ext_clock";
		reset-gpios = <&r_pio 1 3 GPIO_ACTIVE_LOW>; /* PM3 */
		post-power-on-delay-ms = <200>;
	};
};

&axp805 {
	/* ALDO3 is shorted to CLDO1; both inherit regulator-always-on. */
	regulators {
		cldo2 {
			/* unused */
			/delete-property/ regulator-min-microvolt;
			/delete-property/ regulator-max-microvolt;
		};

		cldo3 {
			/* unused */
			/delete-property/ regulator-min-microvolt;
			/delete-property/ regulator-max-microvolt;
		};

		/* DCDCB is polyphased with DCDCA. */
		dcdca {
			regulator-min-microvolt = <800000>;
		};
	};
};

&dwc3 {
	status = "okay";
};

&emac {
	pinctrl-names = "default";
	pinctrl-0 = <&ext_rgmii_pins>;
	phy-mode = "rgmii-id";
	phy-handle = <&ext_rgmii_phy>;
	phy-supply = <&reg_gmac_3v3>;
	allwinner,rx-delay-ps = <0>;
	allwinner,tx-delay-ps = <0>;
	status = "okay";
};

&hdmi {
	hvcc-supply = <&reg_bldo2>;
};

&mdio {
	reset-gpios = <&pio 3 14 GPIO_ACTIVE_LOW>; /* PD14 */
	reset-delay-us = <15000>;
	reset-post-delay-us = <100000>;

	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;

		motorcomm,clk-out-frequency-hz = <125000000>;
		rx-internal-delay-ps = <1950>;
		tx-internal-delay-ps = <1950>;
	};
};

&mmc1 {
	vmmc-supply = <&reg_wifi_3v3>;
	vqmmc-supply = <&reg_bldo3>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";

	aw859a: wifi@1 {
		reg = <1>;
	};
};

&mmc2 {
	vmmc-supply = <&reg_cldo1>;
	vqmmc-supply = <&reg_bldo2>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	cap-mmc-hw-reset;
	non-removable;
	bus-width = <8>;
	status = "okay";
};

&pio {
	vcc-pg-supply = <&reg_bldo3>;
};

&r_pio {
	led_green_pin: led-green-pin {
		pins = "PL7";
		function = "gpio_out";
		drive-strength = <10>;
	};

	led_red_pin: led-red-pin {
		pins = "PL4";
		function = "gpio_out";
		drive-strength = <10>;
	};
};

&usb2phy {
	/delete-property/ usb0_id_det-gpios;
};

&usb3phy {
	status = "okay";
};
